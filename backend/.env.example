# Copy this file to .env and fill in real values.
# None of these are set yet — the site runs with mock/demo data until you add them.

# --- Supabase (database + auth + storage) ---
# Get these from your Supabase project: Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay (payments) ---
# Get these from Razorpay Dashboard: Settings -> API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Resend (order confirmation / shipped / password-reset emails) ---
# Get an API key from https://resend.com — until both of these are set,
# these emails just log to the console instead of sending.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- App ---
PORT=4000
# Also used to build the link inside password-reset emails
# (<FRONTEND_ORIGIN>/reset-password) and passed to Supabase as the
# redirectTo — set this to your real deployed URL in production, not
# localhost, or reset links will point at the wrong place.
FRONTEND_ORIGIN=http://localhost:4000
GST_RATE_PERCENT=5
